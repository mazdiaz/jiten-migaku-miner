{
  "name": "jiten-migaku-miner",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8920",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test -c playwright.prod.config.ts",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "format": "biome format --write src tests",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "next start --hostname 127.0.0.1 --port 8920",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:verify": "tsx --env-file-if-exists=.env.local scripts/db-verify.ts",
    "db:cleanup": "tsx --env-file-if-exists=.env.local scripts/db-cleanup.ts",
    "test:db": "vitest run tests/server"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  }
}
